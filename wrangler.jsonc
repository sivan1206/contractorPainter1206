{
  "name": "istanbul-boyacilik",
  "main": "./worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
